const SHEET_ACOES5W2H = 'Acoes5W2H';
const SHEET_ATAS = 'Atas';

const COLUNAS_ACOES5W2H = ['id','titulo','oQue','porQue','onde','quando','quem','como','quantoCusta','status','projetoId','ataId','tarefaId','criadoPor','criadoEm','atualizadoEm','arquivado'];
const COLUNAS_ATAS = ['id','titulo','data','local','participantes','pauta','decisoes','proximaReuniao','responsavel','criadoPor','criadoEm','atualizadoEm','arquivado'];

/** Garante que as duas abas existam com o cabeçalho certo. Rode uma vez manualmente. */
function garantirAbas5W2HEAtas_(){
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  [[SHEET_ACOES5W2H, COLUNAS_ACOES5W2H], [SHEET_ATAS, COLUNAS_ATAS]].forEach(([nome, colunas])=>{
    let sh = ss.getSheetByName(nome);
    if(!sh){ sh = ss.insertSheet(nome); sh.appendRow(colunas); sh.setFrozenRows(1); }
  });
}

/** Lê uma aba inteira como array de objetos, usando a 1ª linha como cabeçalho. */
function lerAbaComoObjetos_(nomeAba){
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nomeAba);
  if(!sh) return [];
  const valores = sh.getDataRange().getValues();
  if(valores.length < 2) return [];
  const cab = valores[0];
  return valores.slice(1).filter(l=>l[0]!=='').map(l=>{
    const obj = {};
    cab.forEach((c,i)=> obj[c] = l[i]);
    return obj;
  });
}

/** Acrescenta uma linha nova gerando id via Utilities.getUuid(). Retorna o id gerado. */
function inserirLinha_(nomeAba, colunas, dados, usuarioEmail){
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nomeAba);
  const id = Utilities.getUuid();
  const agora = new Date();
  const linha = colunas.map(c=>{
    if(c==='id') return id;
    if(c==='criadoPor') return usuarioEmail||'';
    if(c==='criadoEm' || c==='atualizadoEm') return agora;
    if(c==='arquivado') return false;
    return dados[c] !== undefined ? dados[c] : '';
  });
  sh.appendRow(linha);
  return id;
}

/** Atualiza a linha de um id existente, só nas colunas presentes em `dados`. */
function atualizarLinhaPorId_(nomeAba, colunas, id, dados){
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nomeAba);
  const valores = sh.getDataRange().getValues();
  const idxId = colunas.indexOf('id');
  const idxAtualizadoEm = colunas.indexOf('atualizadoEm');
  for(let i=1;i<valores.length;i++){
    if(String(valores[i][idxId]) === String(id)){
      colunas.forEach((c,j)=>{
        if(c==='id' || c==='criadoPor' || c==='criadoEm') return; // nunca sobrescreve
        if(dados[c] !== undefined) sh.getRange(i+1, j+1).setValue(dados[c]);
      });
      if(idxAtualizadoEm>-1) sh.getRange(i+1, idxAtualizadoEm+1).setValue(new Date());
      return true;
    }
  }
  return false;
}

function arquivarPorId_(nomeAba, colunas, id){
  return atualizarLinhaPorId_(nomeAba, colunas, id, {arquivado:true});
}

