function acaoCriarAcao5w2h(payload, usuarioEmail){
  if(!payload.titulo) return {ok:false, erro:'Título é obrigatório.'};
  const id = inserirLinha_(SHEET_ACOES5W2H, COLUNAS_ACOES5W2H, payload, usuarioEmail);
  return {ok:true, id};
}
function acaoEditarAcao5w2h(payload, usuarioEmail){
  if(!payload.id) return {ok:false, erro:'id é obrigatório.'};
  const ok = atualizarLinhaPorId_(SHEET_ACOES5W2H, COLUNAS_ACOES5W2H, payload.id, payload);
  return ok ? {ok:true} : {ok:false, erro:'Ação 5W2H não encontrada.'};
}
function acaoArquivarAcao5w2h(payload){
  if(!payload.id) return {ok:false, erro:'id é obrigatório.'};
  const ok = arquivarPorId_(SHEET_ACOES5W2H, COLUNAS_ACOES5W2H, payload.id);
